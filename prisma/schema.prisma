// Schema do Laço — plataforma de Amigo Secreto.
// Convenção: modelos em PascalCase no código, tabelas/colunas em snake_case no banco.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ORGANIZER
}

enum MessageDirection {
  TO_RECEIVER // de quem presenteia para quem foi sorteado
  TO_GIVER // resposta de quem foi sorteado para o seu amigo secreto
}

enum DrawStatus {
  OPEN // aceitando participantes
  COMPLETED // sorteio realizado, imutável
}

enum BagDrawStatus {
  OPEN // montando o saco: entra/sai gente, organizador define quem fica por último
  RUNNING // já começou a tirar nomes: ninguém entra nem sai
  COMPLETED // sobrou um nome no saco: é quem ganhou
}

enum TokenPurpose {
  RESET_PASSWORD // "esqueci minha senha"
  VERIFY_EMAIL // confirmação do e-mail (obrigatória só para virar organizador)
}

model User {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(80)
  /// Nome em minúsculas e sem acentos, usado na busca ("joao" encontra "João").
  searchName      String    @map("search_name") @db.VarChar(80)
  /// Sempre normalizado (trim + minúsculas) antes de gravar.
  email           String    @unique @db.VarChar(254)
  role            Role      @default(USER)
  /// Hash scrypt da senha. Nulo em contas antigas (do login por código): definem a senha em "Esqueci minha senha".
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  /// Preenchido quando a pessoa prova que é dona do e-mail (link de confirmação ou de nova senha).
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Quando a foto de perfil mudou pela última vez (versiona a URL da foto; nulo = sem foto).
  avatarUpdatedAt DateTime? @map("avatar_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  gifts          Gift[]
  sessions       Session[]
  authTokens     AuthToken[]
  avatar         UserAvatar?
  participations DrawParticipant[]
  createdDraws   Draw[]            @relation("DrawCreator")
  bagEntries     BagEntry[]
  createdBags    BagDraw[]         @relation("BagDrawCreator")
  reservedBags   BagDraw[]         @relation("BagDrawLast")

  @@index([searchName])
  @@map("users")
}

model Gift {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  title          String    @db.VarChar(120)
  url            String    @db.VarChar(2048)
  description    String?   @db.VarChar(500)
  /// Quando a foto do produto mudou (versiona a URL da foto; nulo = sem foto).
  imageUpdatedAt DateTime? @map("image_updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  image GiftImage?

  @@index([userId, createdAt])
  @@map("gifts")
}

model Session {
  /// SHA-256 do token do cookie. O token em si nunca é gravado.
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Links de uso único enviados por e-mail (nova senha, confirmação de e-mail).
model AuthToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose
  /// SHA-256 do token do link. O token em si nunca é gravado.
  tokenHash String       @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Contadores de janela fixa para rate limiting (funciona com várias instâncias/serverless).
model RateLimit {
  key         String   @id @db.VarChar(128)
  count       Int
  windowStart DateTime @map("window_start")

  @@map("rate_limits")
}

model Draw {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(80)
  description String?    @db.VarChar(500)
  /// Texto livre, ex.: "R$ 100".
  budget      String?    @db.VarChar(40)
  eventDate   DateTime?  @map("event_date") @db.Date
  status      DrawStatus @default(OPEN)
  createdById String?    @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  completedAt DateTime?  @map("completed_at")

  createdBy    User?             @relation("DrawCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants DrawParticipant[]
  results      DrawResult[]

  @@index([status, createdAt])
  @@map("draws")
}

model DrawParticipant {
  id        String   @id @default(cuid())
  drawId    String   @map("draw_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  draw   Draw        @relation(fields: [drawId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  result DrawResult?

  @@unique([drawId, userId])
  @@index([userId])
  @@map("draw_participants")
}

/// Um registro por participante (quem presenteia). O destinatário fica cifrado.
model DrawResult {
  id             String    @id @default(cuid())
  drawId         String    @map("draw_id")
  /// Quem presenteia (DrawParticipant).
  participantId  String    @unique @map("participant_id")
  /// AES-256-GCM(id do usuário sorteado). Só o servidor, com APP_SECRET, consegue ler.
  receiverCipher String    @map("receiver_cipher") @db.VarChar(255)
  /// HMAC(drawId:receiverId) — garante no banco que ninguém é sorteado duas vezes, sem revelar quem.
  receiverHash   String    @map("receiver_hash") @db.VarChar(64)
  revealedAt     DateTime? @map("revealed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  draw        Draw            @relation(fields: [drawId], references: [id], onDelete: Cascade)
  /// NoAction: impede apagar participante (ou usuário) de um sorteio já realizado.
  participant DrawParticipant @relation(fields: [participantId], references: [id], onDelete: NoAction)
  messages    DrawMessage[]

  @@unique([drawId, receiverHash])
  @@index([drawId])
  @@map("draw_results")
}

/// Conversa anônima de um par do sorteio. A conversa pertence ao resultado de quem presenteia;
/// o autor é deduzido pela direção — nenhum id de usuário é gravado na mensagem.
model DrawMessage {
  id         String           @id @default(cuid())
  resultId   String           @map("result_id")
  direction  MessageDirection
  /// AES-256-GCM do texto, amarrado à conversa.
  bodyCipher String           @map("body_cipher") @db.Text
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  result DrawResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId, createdAt])
  @@map("draw_messages")
}

/// Foto de perfil já reprocessada no servidor (WebP 256x256, sem metadados). Tabela separada
/// para a imagem não ser carregada junto em toda consulta de usuário.
model UserAvatar {
  userId    String   @id @map("user_id")
  data      Bytes
  mimeType  String   @map("mime_type") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// Foto do produto (buscada na loja ou enviada pela pessoa), sempre reprocessada no servidor:
/// WebP de até 480px, sem metadados. Copiada para cá para não depender da loja.
model GiftImage {
  giftId    String   @id @map("gift_id")
  data      Bytes
  mimeType  String   @map("mime_type") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@map("gift_images")
}

/// Sorteio do saco: os nomes saem um a um; quem sobra por último no saco ganha.
model BagDraw {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(80)
  description String?       @db.VarChar(500)
  status      BagDrawStatus @default(OPEN)
  /// Quem o organizador marcou para ficar por último (opcional; nulo = sai aleatório).
  /// Só organizadores enxergam este campo.
  lastUserId  String?       @map("last_user_id")
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")

  createdBy User?      @relation("BagDrawCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastUser  User?      @relation("BagDrawLast", fields: [lastUserId], references: [id], onDelete: SetNull)
  entries   BagEntry[]

  @@index([status, createdAt])
  @@map("bag_draws")
}

/// Um nome dentro do saco.
model BagEntry {
  id        String    @id @default(cuid())
  bagDrawId String    @map("bag_draw_id")
  userId    String    @map("user_id")
  /// Ordem em que saiu do saco (1 = primeiro). Nulo = ainda está no saco.
  /// O vencedor recebe a última posição quando o sorteio termina.
  position  Int?
  drawnAt   DateTime? @map("drawn_at")
  createdAt DateTime  @default(now()) @map("created_at")

  bagDraw BagDraw @relation(fields: [bagDrawId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bagDrawId, userId])
  @@unique([bagDrawId, position])
  @@index([userId])
  @@map("bag_entries")
}
