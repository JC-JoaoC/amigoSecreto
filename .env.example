# ─────────────────────────────────────────────────────────────
#  Laço — Amigo Secreto · variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# Postgres. Local (docker compose up -d):
DATABASE_URL="postgresql://laco:laco_dev_password@localhost:5434/laco?schema=public"

# Endereço público da aplicação (usado nos links dos e-mails).
APP_URL="http://localhost:3000"

# Segredo da aplicação (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATENÇÃO: depois do primeiro sorteio NÃO troque este valor — os resultados
# são cifrados com chaves derivadas dele e ficariam ilegíveis.
APP_SECRET=""

# Envio de e-mail
#   console = imprime o e-mail no terminal (só desenvolvimento; bloqueado em produção)
#   smtp    = envio real (Gmail/Google Workspace, Resend, Brevo, Amazon SES, etc.)
MAIL_TRANSPORT="console"
MAIL_FROM="Laço Amigo Secreto <nao-responda@seudominio.com.br>"

# Só para dev/testes: grava cada e-mail como .json nesta pasta.
MAIL_OUTBOX_DIR=".mail-outbox"

# SMTP (obrigatório quando MAIL_TRANSPORT=smtp)
SMTP_HOST=""
SMTP_PORT="587"
# "true" para porta 465 (TLS direto); "false" para 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# E-mails com permissão de organizador (criar e realizar sorteios), separados por vírgula.
# A permissão é aplicada quando a pessoa entra na conta.
ORGANIZER_EMAILS="voce@seudominio.com.br"
